# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，禁止入库）
# OpenAI 兼容协议三件套：
OPENAI_BASE_URL=https://api.openai.com/v1      # 协议地址（兼容 OpenAI 的 API base，如 vLLM / one-api / dashscope 兼容模式等）
OPENAI_MODEL=gpt-4o                            # 模型名（对应 base_url 下的 model id）
OPENAI_API_KEY=your-api-key-here              # 密钥
